filters:
  and:
    - tipo == "proyecto"
formulas:
  estado_icon: if(estado == "activo", "🟢", if(estado == "en produccion", "✅", if(estado == "en pausa", "⏸️", if(estado == "demo", "🎨", if(estado == "laboratorio", "🧪", "💡")))))
properties:
  file.name:
    displayName: Proyecto
  estado:
    displayName: Estado
  conversaciones:
    displayName: Convs.
views:
  - type: table
    name: Por estado
    groupBy:
      property: estado
      direction: ASC
    order:
      - formula.estado_icon
      - file.name
      - conversaciones
    sort:
      - property: conversaciones
        direction: DESC
      - property: file.name
        direction: ASC
  - type: cards
    name: Tarjetas
    order:
      - file.name
      - estado
